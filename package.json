{
  "name": "naf-accountant",
  "version": "1.0.0",
  "description": "منصة وسيطة محاسبية ذكية لشركة ناف لو — Serverless AI Accounting Middleware on Cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test \"test/*.test.mjs\"",
    "db:create": "wrangler d1 create naf-accountant-db",
    "db:migrate": "npm run db:apply -- --remote",
    "db:migrate:local": "npm run db:apply -- --local",
    "db:apply": "node ./scripts/migrate.mjs",
    "db:seed": "wrangler d1 execute naf-accountant-db --file=./migrations/0002_seed_chart_of_accounts.sql --remote",
    "r2:create": "wrangler r2 bucket create naf-accountant-media",
    "tail": "wrangler tail",
    "lint": "npm --prefix frontend run lint"
  },
  "keywords": [
    "cloudflare-workers",
    "hono",
    "d1",
    "accounting",
    "wafeq",
    "telegram-bot",
    "claude-ai"
  ],
  "author": "NAF Law",
  "license": "UNLICENSED",
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
